# ── LLM ──────────────────────────────────────────
# Provider: openai | groq | gemini | nvidia | anthropic | ollama
LLM_PROVIDER=openai
# LLM_MODEL: provider-specific model id, e.g.:
#   groq      -> llama-3.3-70b-versatile
#   gemini    -> gemini-2.0-flash
#   nvidia    -> meta/llama-3.1-70b-instruct
#   anthropic -> claude-sonnet-4-6
#   ollama    -> llama3.1:8b
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL: optional endpoint override for OpenAI-compatible providers.
# Must be left with NOTHING after the "=" (not even a trailing comment) —
# pydantic-settings only strips inline "# ..." comments when a real value
# precedes them; on an empty value the comment text itself becomes the value.
LLM_BASE_URL=

# ── Per-provider keys (fill only what you use) ───
OPENAI_API_KEY=sk-...
GROQ_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1   # no key needed for Ollama

# ── LangSmith tracing ────────────────────────────
# Both a real key AND the flag are required. The literal `lsv2_...` placeholder
# below is treated as unset, so tracing stays off until you paste a real key.
# Verify with: curl localhost:8080/health  ->  {"tracing_enabled": true}
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=ticketwarden
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Agent behavior ───────────────────────────────
MAX_REVIEW_ITERATIONS=2
TEMPERATURE=0.2
MAX_TOOL_ROUNDS=3

# ── Storage ──────────────────────────────────────
# The commerce backend is a local, self-seeded catalog (see
# apps/api/src/store/) — no external order API or network egress required.
SQLITE_PATH=./ticketwarden.db

# ── Service ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# ── UI ───────────────────────────────────────────
API_URL=http://localhost:8080     # Streamlit → API
